BOT_TOKEN=
ADMIN_TELEGRAM_IDS=[]
DATABASE_URL=postgresql+asyncpg://vpn:vpn@localhost:5432/vpn
APP_ENV=development
VLESS_PROVIDER=mock
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Exact panel version; no endpoints are assumed
THREEXUI_VERSION=
THREEXUI_BASE_URL=
THREEXUI_USERNAME=
THREEXUI_PASSWORD=
CRYPTOBOT_TOKEN=
CRYPTOBOT_ENABLED=false
CRYPTOBOT_TESTNET=true
BILLING_INTERVAL_SECONDS=60

# Optional host-side PostgreSQL port used by Compose; update DATABASE_URL for local Python too.
POSTGRES_PORT=5432
